# Anthropic API key (legacy path; only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# LLM provider (v1.6.4): "anthropic" (default) or a free-tier OpenAI-compatible
# provider: gemini | groq | nvidia | openai | openai-compat (needs LLM_BASE_URL).
# Free keys: aistudio.google.com (gemini), console.groq.com (groq) — no credit card.
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-free-tier-key
# LLM_MODEL=gemini-2.5-flash              # optional; preset default otherwise
#                                         # (groq preset default: openai/gpt-oss-120b)
# LLM_BASE_URL=                           # optional override; required for openai-compat
# BUDGET_RATE_CARD_USD_PER_M=0.30,2.50    # optional: cost estimate USD per M tokens (in,out)

# Model to use (Claude path)
CLAUDE_MODEL=claude-sonnet-4-20250514

# SQLite database path (relative to project root)
DB_PATH=data/guardrails.db

# Retry settings for transient tool failures
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.0

# Worker iterations cap (each worker is a bounded tool-use loop)
WORKER_MAX_ITERATIONS=5

# Row-count threshold: UPDATE/DELETE affecting more than this many rows requires approval
RISKY_ROW_THRESHOLD=5

# Cost budget per session in USD (0 = unlimited)
SESSION_COST_BUDGET_USD=0.50

# Token budget per session (0 = unlimited)
SESSION_MAX_TOKENS=8192

# PostgreSQL: set to a postgres:// URL to use PostgreSQL instead of SQLite
# DATABASE_URL=

# Redis: short-term memory sync (graceful fallback if unreachable)
# REDIS_URL=redis://localhost:6379/0

# SELECT cache size for the bounded LRU inside SQLTool (0 disables)
SQL_QUERY_CACHE_SIZE=128

# Webapp rate limiters (0 disables)
CHAT_RATE_PER_MIN=30
SSE_MAX_PER_IP=3

# Logging level for the structured logger (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log encoding: text (default, human-readable) or json (one object per
# line, for aggregators like Loki/CloudWatch).
# LOG_FORMAT=json

# A session counts as active while activity lands within this window (minutes)
SESSION_IDLE_MINUTES=15

# Column deny policy lives in config.py (COLUMN_POLICY, empty by default).
# NER second pass for PII masking (0 = regex only, 1 = + spaCy NER).
# Off by default with measured reason — see config.py comment.
PII_NER_ENABLED=0

# Router confidence gate (0.0-1.0): structured route replies below this
# ask the user to clarify instead of guessing. Tune from router_eval.py.
ROUTER_CONFIDENCE_THRESHOLD=0.6

# Web session signing secret (Phase 1 auth). Leave empty for an ephemeral
# per-process secret (logins die on restart, fine for local dev); set a
# long random value in production.
# SESSION_SECRET=change-me-to-a-long-random-string
